					</Properties>
					<Action><![CDATA[receiveOrder();]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750106380329</Id>
					<Name><![CDATA[createOrder]]></Name>
					<X>650</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[total_cost = total_cost_order + total_cost_holding + total_cost_shortage;
if (inventory <= reorder_s && order_amount == 0) {
	order_amount = objetive_S - inventory;
	delivery.restart();
	total_cost_order += cost_order +cost_order_unit*order_amount;
	total_cost+= cost_order;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750107451400</Id>
					<Name><![CDATA[createArrival]]></Name>
					<X>650</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int d = poisson(lambda_items);
updateHoldingCost();

if (inventory >= d) {
    inventory -= d;
} else {
    int shortage = d - inventory;
    total_cost_shortage += shortage * cost_shortage;
    total_cost+=shortage * cost_shortage;
    inventory = 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750203607076</Id>
					<Name><![CDATA[receiveOrder]]></Name>
					<X>650</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[updateHoldingCost();
inventory += order_amount;
order_amount = 0;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750253017177</Id>
					<Name><![CDATA[updateHoldingCost]]></Name>
					<X>650</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double now = time();
double delta_t = now - last_inventory_check_time;
total_cost_holding += inventory * cost_holding * delta_t;
total_cost+= inventory * cost_holding * delta_t;
last_inventory_check_time = now;]]></Body>
				</Function>
			</Functions>
